# Browser-visible Geoapify key. Restrict origins/referrers in your Geoapify project.
VITE_GEOAPIFY_API_KEY=
VITE_GEOAPIFY_STYLE=osm-bright-smooth
# Optional browser-visible key for the Yandex Tiles API comparison.
VITE_YANDEX_MAPS_API_KEY=

# Optional Yandex JavaScript API 3.0 browser key; allow the Pages domain and localhost.
VITE_YANDEX_JS_API_KEY=

# Optional cloud snapshot sharing. Publishable key only; NEVER service_role/secret keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
